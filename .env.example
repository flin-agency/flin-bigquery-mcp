# Desktop OAuth (same setup as other flin Google MCPs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_BIGQUERY_PROJECT=
GOOGLE_BIGQUERY_LOCATION=EU
# oauth (default) or adc (Application Default Credentials)
GOOGLE_BIGQUERY_AUTH_MODE=oauth
# Hard per-query ceiling: 1 GiB. Tool calls may lower, never raise it.
GOOGLE_BIGQUERY_MAX_BYTES_BILLED=1073741824
# GOOGLE_BIGQUERY_TOKEN_PATH=/absolute/private/directory/token.json
# GOOGLE_BIGQUERY_TOKEN_DIR=/absolute/private/directory/accounts
# GOOGLE_BIGQUERY_OAUTH_PORT=0
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
